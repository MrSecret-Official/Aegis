// Recursos de aegis-setup.exe (los compila build.rs con windres).
1 ICON "aegis.ico"
1 24 "aegis-setup.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Aegis"
      VALUE "FileDescription", "Aegis Setup"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "aegis-setup"
      VALUE "LegalCopyright", "MPL-2.0"
      VALUE "OriginalFilename", "aegis-setup.exe"
      VALUE "ProductName", "Aegis"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
