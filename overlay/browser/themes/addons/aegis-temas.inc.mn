  content/builtin-themes/aegis-medianoche/_locales/fr/messages.json    (aegis-medianoche/_locales/fr/messages.json)
  content/builtin-themes/aegis-medianoche/_locales/it/messages.json    (aegis-medianoche/_locales/it/messages.json)
