DIRS += ["content", "locales"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

include("../branding-common.mozbuild")
FirefoxBranding()

# Las prefs de Aegis (settings/prefs) las añade tools/aegis.py al final de pref/firefox-branding.js en el árbol:
# ese archivo sí está en browser/installer/package-manifest.in (un archivo nuevo de prefs no se empaquetaría) y se
# lee después de firefox.js, así que gana (Preferences.cpp, pref_ReadDefaultPrefs: orden alfabético inverso).
