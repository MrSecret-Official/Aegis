# Aegis · motor de Escudos, variante «propio» (plan B): la misma que Cargo.toml, pero con nuestra copia de
# adblock-rust 0.12.1 (adblock/, tal cual del third_party/rust de Firefox 157.0.1; ver adblock-origen.json) en vez de
# etp_engine, el fork de Mozilla. tools/aegis.py la pone en el árbol como Cargo.toml cuando upstream.json › escudos ›
# motor es "propio", y entonces aplica patches/0600-escudos/alternativos/propio/0001-motor-en-gkrust.patch (que además
# saca adblock/ del workspace, para que Cargo no le pida sus dependencias de pruebas ni las opcionales).
[package]
name = "aegis_escudos_motor"
version = "1.0.0"
edition = "2021"
license = "MPL-2.0"
publish = false

[dependencies]
# Las mismas features que con etp_engine: sin el resolvedor de dominios incrustado (src/lib.rs, Resolvedor) ni
# css-validation.
adblock = { path = "adblock", features = ["full-regex-handling", "single-thread"], default-features = false }
moz_task = { path = "../../../../../xpcom/rust/moz_task" }
nserror = { path = "../../../../../xpcom/rust/nserror" }
nsstring = { path = "../../../../../xpcom/rust/nsstring" }
# Leer recursos.json (formato Resource de adblock-rust) y dar el cosmético en JSON.
serde_json = "1"
thin-vec = { version = "0.2.1", features = ["gecko-ffi"] }
xpcom = { path = "../../../../../xpcom/rust/xpcom" }
