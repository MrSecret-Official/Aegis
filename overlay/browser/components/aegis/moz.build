for idioma in ["en-US", "es-ES", "pt-BR", "fr", "de", "it"]:
    EXTRA_JS_MODULES.aegis.locales[idioma] += [
        "locales/%s/aegis.ftl" % idioma,
        "locales/%s/conexiones.ftl" % idioma,
        "locales/%s/escudos-ayuda.ftl" % idioma,
    ]

EXTRA_JS_MODULES.aegis.fuentes += [
    "fuentes/Inter-LICENSE.txt",
    "fuentes/InterVariable.woff2",
]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")
