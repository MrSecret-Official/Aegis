EXTRA_JS_MODULES.aegis.escudos.filtros.licencias += [
    "escudos/filtros/licencias/CC-BY-SA-3.0.txt",
    "escudos/filtros/licencias/GPL-3.0.txt",
    "escudos/filtros/licencias/MPL-2.0.txt",
]

# Webs en oscuro: motor de Dark Reader (MIT) con su configuración de arreglos, dentro del navegador.
EXTRA_JS_MODULES.aegis["webs-oscuro"] += [
    "webs-oscuro/AegisWebsOscuroChild.sys.mjs",
    "webs-oscuro/arreglos.sys.mjs",
    "webs-oscuro/dark-sites.config",
    "webs-oscuro/darkreader-LICENSE.txt",
    "webs-oscuro/darkreader.js",
    "webs-oscuro/detector-hints.config",
    "webs-oscuro/dynamic-theme-fixes.config",
    "webs-oscuro/webs-oscuro.sys.mjs",
]

# Tor (descarga aparte y opcional, ventana privada con Tor en una instancia aparte). tor.json lo escribe
# `aegis.py tor-fijar`: versión, URL, tamaño y sha256 del Tor Expert Bundle que se ofrece descargar.
EXTRA_JS_MODULES.aegis.tor += [
    "tor/aislamiento.sys.mjs",
    "tor/descarga.sys.mjs",
    "tor/proceso.sys.mjs",
    "tor/tor.json",
    "tor/tor.sys.mjs",
]

