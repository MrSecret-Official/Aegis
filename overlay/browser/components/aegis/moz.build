# Código de Aegis: se instala en resource:///modules/aegis/ (lo empaqueta «@RESPATH@/browser/modules/*» de
# package-manifest.in) y lo llama BrowserComponents.manifest (parche 0500-ui/0001). Las rutas entre estos
# archivos son relativas, igual que en el modo desarrollo (resource://aegis/ apuntando al repo).

EXTRA_JS_MODULES.aegis += [
    "accesos.sys.mjs",
    "acciones.sys.mjs",
    "acerca.sys.mjs",
    "AegisArranque.sys.mjs",
    "ajustes.sys.mjs",
    "barra-lateral.sys.mjs",
    "bienvenida.sys.mjs",
    "buscador.sys.mjs",
    "busqueda-limpia.sys.mjs",
    "complementos.sys.mjs",
    "conexiones.sys.mjs",
    "contrasenas-panel.sys.mjs",
    "contrasenas.sys.mjs",
    "enfasis-propio.sys.mjs",
    "enfasis.sys.mjs",
    "escudos-ayuda.sys.mjs",
    "escudos.sys.mjs",
    "google.sys.mjs",
    "huella.sys.mjs",
    "icono.sys.mjs",
    "instalador.sys.mjs",
    "logos.sys.mjs",
    "marcadores.sys.mjs",
    "modos.sys.mjs",
    "selector-enfasis.sys.mjs",
]

EXTRA_JS_MODULES.aegis.estilos += [
    "estilos/ajustes-sombra.css",
    "estilos/ajustes.css",
    "estilos/barra-lateral.css",
    "estilos/barra-marcadores.css",
    "estilos/codigos.css",
    "estilos/complementos-sombra.css",
    "estilos/complementos.css",
    "estilos/contrasenas-panel.css",
    "estilos/escudos.css",
    "estilos/extensiones.css",
    "estilos/fuentes.css",
    "estilos/interfaz.css",
    "estilos/lanzador.css",
    "estilos/mapeo-firefox.css",
    "estilos/marcadores.css",
    "estilos/selector-enfasis.css",
    "estilos/tokens.css",
    "estilos/tor.css",
]

# Códigos de verificación (TOTP): el cálculo, el almacén cifrado y el autorrelleno (sus actores se registran solo
# mientras haya códigos guardados). El diálogo para añadirlos va en el manifiesto chrome (dialogos/, aegis-temas.inc.mn).
EXTRA_JS_MODULES.aegis.autenticador += [
    "autenticador/AegisCodigosChild.sys.mjs",
    "autenticador/AegisCodigosParent.sys.mjs",
    "autenticador/autenticador.sys.mjs",
    "autenticador/panel.sys.mjs",
    "autenticador/totp.sys.mjs",
]

# Pasar las contraseñas a otro Aegis con el código de 6 palabras: el formato y el cifrado (formato.sys.mjs, sin Gecko),
# la lista de palabras del EFF (CC BY 3.0, con su aviso) y el lado del navegador. Los diálogos van en el manifiesto
# chrome (dialogos/, aegis-temas.inc.mn).
EXTRA_JS_MODULES.aegis.contrasenas.transferencia += [
    "contrasenas/transferencia/eff-wordlist-LICENSE.txt",
    "contrasenas/transferencia/formato.sys.mjs",
    "contrasenas/transferencia/palabras.sys.mjs",
    "contrasenas/transferencia/transferencia.sys.mjs",
]

# Importar de Firefox y de otro perfil de Aegis (migradores que registra MIGRATOR_MODULES, parche 0900-migracion/0001)
# y las contraseñas por el CSV en el asistente (Brave, Edge, Firefox; otro perfil de Aegis, con su explicación). El
# icono del origen «Firefox» va en el manifiesto chrome (aegis-temas.inc.mn).
EXTRA_JS_MODULES.aegis.migracion += [
    "migracion/asistente.sys.mjs",
    "migracion/fusion.sys.mjs",
    "migracion/migradores.sys.mjs",
]

# Icono alternativo que se elige en Ajustes › Apariencia (lo genera tools/iconos.py en la marca).
EXTRA_JS_MODULES.aegis["iconos-app"] += [
    "/browser/branding/aegis/alternos/uroboros-64.png",
    "/browser/branding/aegis/alternos/uroboros.ico",
]

# Escudos: el bloqueador propio. Motor (adblock-rust en gkrust tras un servicio XPCOM, escudos/motor-nativo/; aquí,
# su módulo y el worker que prepara las listas), catálogo de listas, recursos neutros y scriptlets (`aegis.py recursos-escudos`), el cosmético de las páginas (cosmetico.sys.mjs
# y su actor) y la instantánea de las listas de serie de sus autores (filtros/ del repo, `aegis.py filtros`; la copia al
# árbol `aegis.py overlay`), con sus licencias y la atribución (AVISO.txt).
EXTRA_JS_MODULES.aegis.escudos += [
    "escudos/AegisEscudosChild.sys.mjs",
    "escudos/ajustes.sys.mjs",
    "escudos/catalogo.json",
    "escudos/cosmetico.sys.mjs",
    "escudos/etp.sys.mjs",
    "escudos/excepciones.sys.mjs",
    "escudos/listas.sys.mjs",
    "escudos/motor-worker.js",
    "escudos/motor.sys.mjs",
    "escudos/procedural.sys.mjs",
    "escudos/recursos.json",
    "escudos/red.sys.mjs",
]

# El motor de Escudos: interfaz y registro del servicio (el código Rust lo enlaza gkrust, parche 0600-escudos/0001).
DIRS += ["escudos/motor-nativo"]

EXTRA_JS_MODULES.aegis.escudos.filtros += [
    "escudos/filtros/adguard-banners-apps.txt",
    "escudos/filtros/adguard-base.txt",
    "escudos/filtros/adguard-cookies.txt",
