+  /**
+   * Aegis: ¿puede sincronizarse esta colección («bucket/colección»)? Sin
+   * identificador: ¿hay alguna? Las permitidas van en
+   * aegis.remotesettings.colecciones («bucket/colección» o «bucket/*»,
+   * separadas por comas), que escribe Aegis (conexiones.sys.mjs) con lo que el
+   * usuario acepta en la bienvenida. De serie está vacía: ninguna conexión.
+   */
+  aegisPermite(identifier) {
+    const permitidas = Services.prefs
+      .getStringPref("aegis.remotesettings.colecciones", "")
+      .split(",")
+      .map(c => c.trim())
+      .filter(Boolean);
+    if (!identifier) {
+      return !!permitidas.length;
+    }
+    const bucket = identifier.split("/")[0];
+    return (
+      permitidas.includes(identifier) || permitidas.includes(`${bucket}/*`)
+    );
+  },
